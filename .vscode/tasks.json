{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Rebuild Java Project",
            "type": "shell",
            "command": "javac",
            "args": [
                "-d",
                "bin",
                "src/*.java"
            ],
            "options": {
                "env": {
                    "JAVA_HOME": "/Users/ivo/.jdk/jdk-25/Contents/Home",
                    "PATH": "/Users/ivo/.jdk/jdk-25/Contents/Home/bin:${env:PATH}"
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$javac"]
        }
    ]
}